# ─── Database (Supabase PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:YOUR-PASSWORD@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ─── LLM Provider ──────────────────────────────────────────────────
# For OpenRouter (temporary testing):
OPENAI_API_KEY=sk-or-v1-your-openrouter-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemma-3-1b-it:free

# For OpenAI (production):
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o

# ─── Engine ─────────────────────────────────────────────────────────
ENGINE_VERSION=1.0.0
LOG_LEVEL=INFO
